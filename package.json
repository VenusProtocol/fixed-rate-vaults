{
  "name": "@venusprotocol/fixed-rate-vaults",
  "version": "1.0.0-dev.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VenusProtocol/fixed-rate-vaults.git"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "yarn@3.2.0",
  "files": [
    "src",
    "out",
    "deployments"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "lint:sol": "solhint 'src/**/*.sol'",
    "format": "forge fmt && prettier --write \"**/*.{js,json,md,ts,yaml,yml}\"",
    "format:check": "forge fmt --check && prettier --check \"**/*.{js,json,md,ts,yaml,yml}\"",
    "build": "forge build --sizes",
    "test": "forge test -vvv",
    "export-deployments": "node scripts/export-deployments.js",
    "export-abis": "node scripts/export-abis.js",
    "coverage": "forge coverage --report lcov",
    "semantic-release": "semantic-release"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.2",
    "solhint": "^6.0.3"
  }
}
